{
  "info": {
    "name": "TrainFyre REST API",
    "description": "Example requests for every operation of the TrainFyre REST API (version 0.1). Run the dev profile with the seed data, log in first and the token is stored automatically. The TLS certificate is self-signed, so disable SSL certificate verification in Postman or trust the local certificate.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminUsername",
      "value": "admin"
    },
    {
      "key": "adminPassword",
      "value": "admin123456789"
    },
    {
      "key": "userUsername",
      "value": "dev_alice"
    },
    {
      "key": "userPassword",
      "value": "TrainFyre-dev-Alice-2026!"
    },
    {
      "key": "userId",
      "value": "11111111-1111-4111-8111-111111111111"
    },
    {
      "key": "incidenceId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Log in as ADMIN (seed user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public. Stores the access token in the `token` collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Log in as USER (seed user)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{userUsername}}\",\n  \"password\": \"{{userPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public. Stores the access token in the `token` collection variable."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('token', body.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"new.user\",\n  \"password\": \"a-long-password-123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Public. Returns 201 with the UUID of the new user. Username: 3-32 characters (letters, digits, dot, hyphen, underscore). Password: 12-128 characters."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('userId', pm.response.text().replace(/\"/g, ''));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get authenticated user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            }
          }
        },
        {
          "name": "Get user by id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}"
              ]
            },
            "description": "Only the owner of the account is allowed."
          }
        },
        {
          "name": "Update authenticated user (username)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"renamed.user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Update authenticated user (password)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"password\": \"another-long-password-456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Add an alert subscription",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alertSubscriptionListToAdd\": [\n    {\n      \"lines\": [\n        101,\n        103\n      ],\n      \"startTime\": \"2026-11-16T07:00:00+01:00\",\n      \"endTime\": \"2026-11-16T09:30:00+01:00\",\n      \"daysOfTheWeek\": [\n        \"MONDAY\",\n        \"TUESDAY\",\n        \"WEDNESDAY\",\n        \"THURSDAY\",\n        \"FRIDAY\"\n      ],\n      \"expiration\": \"2027-06-30T23:59:59+02:00\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete an alert subscription",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "me"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"alertSubscriptionListToDelete\": [\n    {\n      \"lines\": [\n        101,\n        103\n      ],\n      \"startTime\": \"2026-11-16T07:00:00+01:00\",\n      \"endTime\": \"2026-11-16T09:30:00+01:00\",\n      \"daysOfTheWeek\": [\n        \"MONDAY\",\n        \"TUESDAY\",\n        \"WEDNESDAY\",\n        \"THURSDAY\",\n        \"FRIDAY\"\n      ],\n      \"expiration\": \"2027-06-30T23:59:59+02:00\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Send exactly the same object that was returned by the API."
          }
        },
        {
          "name": "Update user by id",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"renamed.user\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete user by id",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/users/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "users",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Incidences",
      "item": [
        {
          "name": "List incidences (public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/incidence?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "incidence"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Create incidence (ADMIN)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/incidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "incidence"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"affectedNetwork\": {\n    \"mapId\": 1,\n    \"lineIds\": [\n      101,\n      103\n    ]\n  },\n  \"occurrence\": {\n    \"timestamp\": \"2026-11-16T08:15:00Z\",\n    \"duration\": \"PT45M\"\n  },\n  \"description\": {\n    \"name\": \"Technical failure on the metro\",\n    \"summary\": \"Delays caused by a signalling problem.\"\n  },\n  \"classification\": {\n    \"severity\": \"MODERATE\",\n    \"cause\": \"TECHNICAL_PROBLEM\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires the ADMIN role. Returns 201 with the UUID of the incidence."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('incidenceId', pm.response.text().replace(/\"/g, ''));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get incidence by id (ADMIN)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/incidence/{{incidenceId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "incidence",
                "{{incidenceId}}"
              ]
            }
          }
        },
        {
          "name": "Update incidence (ADMIN)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/incidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "incidence"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"uuid\": \"{{incidenceId}}\",\n  \"changeDescription\": {\n    \"name\": \"Technical failure on the metro\",\n    \"summary\": \"Service restored.\"\n  },\n  \"changeClassification\": {\n    \"severity\": \"LOW\",\n    \"cause\": \"TECHNICAL_PROBLEM\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires the ADMIN role. Every change* field is optional."
          }
        },
        {
          "name": "Delete incidence (ADMIN)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/incidence",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "incidence"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": \"{{incidenceId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Requires the ADMIN role."
          }
        }
      ]
    },
